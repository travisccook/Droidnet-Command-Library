        { "id": "dfp.volDown", "name": "Volume Down (-2)", "safety": "cosmetic", "encoder": "template",
          "template": ";D,VOLDN", "params": [], "examples": [";D,VOLDN"], "commentLabel": "DFPlayer vol down", "category": "Volume" },
        { "id": "dfp.reset", "name": "Reset Module", "safety": "config", "encoder": "template",
          "template": ";D,RESET", "params": [], "examples": [";D,RESET"], "commentLabel": "DFPlayer reset", "category": "System" },
        { "id": "dfp.status", "name": "Query Play Status", "safety": "cosmetic", "encoder": "template",
          "template": ";D,STATUS", "params": [], "examples": [";D,STATUS"], "commentLabel": "DFPlayer status", "category": "System" }
      ],
