          "safety": "cosmetic",
          "encoder": "template",
          "template": ";L{wledId},FX,{index},{speed},{intensity}",
          "params": [
            { "name": "wledId", "label": "WLED ID (1-9)", "type": "int", "min": 1, "max": 9, "default": 1, "required": true },
            { "name": "index", "label": "Effect #", "type": "int", "min": 0, "max": 255, "default": 0, "required": true },
            { "name": "speed", "label": "Speed (0-255)", "type": "int", "min": 0, "max": 255, "default": 128, "required": true },
            { "name": "intensity", "label": "Intensity (0-255)", "type": "int", "min": 0, "max": 255, "default": 128, "required": true }
          ],
